{
  "schema": "aegis.role-registry/v1",
  "routes": [
    ["front-door", "orchestrator"],
    ["orchestrator", "lane"],
    ["orchestrator", "root"],
    ["router", "root"],
    ["router", "orchestrator"],
    ["decider", "orchestrator"],
    ["decider", "root"]
