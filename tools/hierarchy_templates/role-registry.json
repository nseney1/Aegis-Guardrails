      "independence": {"rule": "none", "separate_session": false},
      "model_profile": {"source": "fixed", "effort": "medium", "tier": "ultrafast"},
      "reports_to": "root",
      "provision": {"adapter": "mailbox", "reader_shell": false, "assistants": null, "team_kind": false}
