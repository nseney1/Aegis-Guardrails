      "approvals": [],
      "prohibitions": {
        "reads": ["source", "board"],
        "writes": ["source", "board", "job_evidence", "worktree_lease", "governance"],
        "calls": ["mailbox:dispatch", "mailbox:job_request", "session:start", "session:resume", "session:stop",
