    "root": {
      "title": "ROOT",
      "kind": "global",
      "m1": "loop",
      "responsibility": "Talks with the owner; approves or denies canonical requests; read-only",
      "endpoint": {"role": "root"},
      "hat_of": null,
      "service": null,
      "lifecycle_role": "root",
      "reads": ["source", "mailbox", "lifecycle", "job_evidence", "owner_records"],
      "writes": ["lifecycle:succeed"],
      "calls": [],
      "approvals": ["lifecycle:decision"],
      "prohibitions": {
        "reads": [],
        "writes": ["source", "mailbox", "board", "job_evidence", "worktree_lease", "governance"],
        "calls": ["mailbox:dispatch", "mailbox:job_request", "session:start", "session:resume", "session:stop",
                  "session:wake", "job:run", "merge", "publish_release"],
        "approvals": ["owner_reserved", "release_signature"]
      },
      "independence": {"rule": "not-requester", "separate_session": true},
      "model_profile": {"source": "team"},
      "reports_to": "owner",
      "provision": {"adapter": "decision", "reader_shell": false, "assistants": null, "team_kind": false}
    },
    "router": {
      "title": "Router",
      "kind": "global",
      "m1": "loop",
      "responsibility": "Intake, deduplication, routing, status; cannot approve or execute",
      "endpoint": {"role": "router"},
      "hat_of": null,
      "service": null,
      "lifecycle_role": "router",
      "reads": ["mailbox", "lifecycle"],
      "writes": ["mailbox", "lifecycle:publish", "lifecycle:read", "lifecycle:route", "lifecycle:succeed"],
