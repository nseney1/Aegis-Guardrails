{
  "schema": "aegis.hierarchy-job-recipes/v1",
  "python": "/REPLACE/WITH/dev-venv/bin/python",
  "path": [
    "/usr/local/bin",
    "/usr/bin",
    "/bin"
  ],
  "prefix": [
    "/usr/bin/nice",
    "-n",
    "10",
    "/usr/bin/ionice",
    "-c",
    "2",
    "-n",
    "7"
  ],
  "hide": [
    "/REPLACE/WITH/your/home/folder"
  ],
  "ro_binds": [],
  "env": {
    "PYTHONPATH": "$checkout",
    "CARGO_NET_OFFLINE": "true",
    "RUSTUP_AUTO_INSTALL": "0"
  },
  "identity": {
    "name": "Aegis hierarchy root",
    "email": "root@example.invalid"
  },
  "recipes": {
    "targeted-tests": {
      "kind": "command",
      "heavy": true,
      "sandbox": "bwrap",
      "timeout_seconds": 1200,
      "steps": [
        [
          "$python",
          "-B",
          "-m",
          "pytest",
          "-q",
          "-p",
          "no:cacheprovider",
          "--basetemp",
          "$scratch",
          "$paths"
        ]
      ]
    },
    "full-suite": {
      "kind": "command",
      "heavy": true,
      "sandbox": "bwrap",
      "timeout_seconds": 1800,
      "steps": [
        [
          "$python",
          "-B",
          "-m",
          "pytest",
          "tests/",
          "-q",
          "-n",
          "2",
          "-p",
          "no:cacheprovider",
          "--basetemp",
          "$scratch"
        ]
      ]
    },
    "lint": {
      "kind": "command",
      "heavy": false,
      "sandbox": "bwrap",
      "timeout_seconds": 300,
      "steps": [
        [
          "$python",
          "-m",
          "ruff",
          "check",
          "--no-cache",
          "$paths"
        ]
      ]
    },
    "aegis-check": {
      "kind": "command",
      "heavy": false,
      "sandbox": "bwrap",
      "timeout_seconds": 300,
      "steps": [
        [
          "$python",
          "-B",
          "-m",
          "aegis_cli",
          "check"
        ]
      ]
    },
    "commit-exact": {
      "kind": "commit",
      "sandbox": "bwrap",
      "timeout_seconds": 120
    }
  }
}
